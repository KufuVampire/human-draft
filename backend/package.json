		"@types/express-session": "^1.18.2",
		"@types/jest": "^29.5.14",
		"@types/ms": "^2.1.0",
		"@types/node": "^22.10.7",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
