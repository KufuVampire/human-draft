{
	"name": "backend",
	"version": "1",
	"private": true,
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs",
		"test:e2e": "vitest run --config ./test/vitest-e2e.config.mts",
		"db:push": "prisma db push",
		"db:gen": "prisma generate",
		"db:seed": "prisma db seed",
		"studio": "prisma studio"
	},
	"dependencies": {
		"@apollo/server": "^5.2.0",
		"@as-integrations/express5": "^1.1.2",
		"@aws-sdk/client-s3": "^3.966.0",
		"@nestjs/apollo": "^14.0.3",
		"@nestjs/common": "^12.2.0",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.2.0",
		"@nestjs/graphql": "^14.0.3",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^12.2.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"argon2": "^0.44.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"connect-redis": "^9.0.0",
		"cookie-parser": "^1.4.7",
		"dataloader": "^2.2.3",
		"express-session": "^1.18.2",
		"graphql": "^16.12.0",
		"graphql-type-json": "^0.3.2",
		"graphql-upload-ts": "^2.1.3",
		"prisma": "^7.10.1",
		"redis": "^5.10.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^12.0.10",
		"@nestjs/schematics": "^12.0.10",
		"@nestjs/testing": "^12.2.0",
		"@swc/cli": "^0.6.0",
		"@swc/core": "^1.10.7",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
