NODE_ENV= #development or production

APPLICATION_PORT=4000
APPLICATION_URL=http://localhost:${APPLICATION_PORT}
ALLOWED_ORIGINS=http://localhost:3000 # client url
GRAPHQL_PREFIX=/graphql

COOKIE_SECRET=cookie-secret

SESSION_SECRET=session-secret
SESSION_NAME=cookie-name
SESSION_DOMAIN=domain
SESSION_MAX_AGE=30d # cookie max age - default 30 days
SESSION_HTTP_ONLY=true
SESSION_SECURE=false # true if https
SESSION_FOLDER=sessions:

DATABASE_CLIENT=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your-db-name
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-name-password
DATABASE_URL=postgresql://<your-db-username>:<your-db-password>@localhost:5432/<your-db-name>?schema=public

REDIS_USER=default
REDIS_PASSWORD=redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

S3_REGION=your-backet-region
S3_ACCESS_KEY_ID=your-backet-key-id
S3_SECRET_ACCESS_KEY=your-backet-access-key
S3_BUCKET_NAME=your-backet-name