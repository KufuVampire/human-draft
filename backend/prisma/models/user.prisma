model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String   @unique
  password      String
  description   String?
  avatarUrl     String?  @map("avatar_url")
  posterUrl     String?  @map("poster_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}
