model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fromUserId String @map("from_user_id")
  toUserId   String @map("to_user_id")

  fromUser User @relation("subscriptionsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("subscriptionsTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("subscriptions")
}
